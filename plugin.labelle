// labelle-android package manifest (manifest v2, labelle-cli provider
// contract): runtime services plus the `android` provider (labelle-cli#405).
//
// `.name = "android"` because the assembler derives a plugin's module alias
// as `labelle_<name>` (labelle-assembler `deps_linker.zig` /
// `build_files/build_zig.zig`), and this package's one module is
// `labelle_android` — the same name its `build.zig.zon` declares, so no
// `b.modules.put` alias is needed. The CLI also requires the `.plugins` entry,
// the registry package and `.provider_config .package` to use this name.
//
// Every command runs the one host tool `bin/labelle-android`
// (`tools/main.zig`, built by `zig build install-provider`), which dispatches
// on the invocation. `command_contract` admits exactly the wire versions its
// strict decoder (`tools/provider_contract.zig` `supported_versions`) accepts
// from 1.2.0 (the first wire with `target_dir`) up: a future 1.4.x patch is
// not admitted until the decoder learns it.
//
// Commands (`labelle android <cmd>`) act on already-built output; building
// happens through `labelle build|run|bundle --platform=android`, whose
// hooks this package supplies:
//   - `package` after `build`: packages `zig-out/apk/game.apk` from the core
//     build's `libgame.so`, so `labelle build` yields an installable APK
//     (skipped under `labelle bundle`, wire 1.4.0 `final_step`: the bundle
//     replacement packages the release APK, labelle-cli#443);
//   - `deploy` replacing `run`: installs that APK and launches it, turning
//     the `run` options into `am start --es` launch extras;
//   - `bundle` replacing `bundle`: the release APK, `versionCode` stamped
//     from `--build-number`.
.{
    .name = "android",
    .manifest_version = 2,
    .command_contract = ">=1.2.0 <1.4.1",
    .namespace = "android",
    .targets = .{"android"},
    .commands = .{
        .{ .name = "doctor", .build_step = "install-provider", .executable = "bin/labelle-android", .help = "Check the Android SDK/NDK/JDK (--json)", .needs_project = false },
        .{ .name = "run", .build_step = "install-provider", .executable = "bin/labelle-android", .help = "Install and launch the built APK (--device, --apk)", .needs_project = true },
        .{ .name = "deploy", .build_step = "install-provider", .executable = "bin/labelle-android", .help = "Publish the bundled APK as a GitHub Release (--tag, --channel, --notes-file, --apk)", .needs_project = true },
    },
    .hooks = .{
        .{ .id = "package", .step = .build, .target = "android", .when = .after, .build_step = "install-provider", .executable = "bin/labelle-android" },
        .{ .id = "deploy", .step = .run, .target = "android", .when = .replace, .build_step = "install-provider", .executable = "bin/labelle-android" },
        .{ .id = "bundle", .step = .bundle, .target = "android", .when = .replace, .build_step = "install-provider", .executable = "bin/labelle-android" },
    },
}
